<style>
:root {
    --primary: {{ options.color_primary }};
    --text: #222;
    --muted: #666;
}
@page { size: A4; margin: 11mm 15mm 10mm; }
* { box-sizing: border-box; margin: 0; padding: 0; }
html { background: white; }
body {
    font-family: 'EB Garamond', 'Garamond', 'Georgia', serif;
    font-size: 10pt;
    line-height: 1.28;
    color: var(--text);
    font-variant-numeric: oldstyle-nums;
}
@media screen {
    body { width: 210mm; padding: 11mm 15mm 10mm; }
}
a { color: inherit; text-decoration: none; }
em { font-style: italic; }
.muted { color: var(--muted); }
.sep { color: var(--primary); margin: 0 0.45em; }
.term { font-weight: 600; }

header { text-align: center; margin-bottom: 1mm; }
header h1 {
    font-size: 25pt;
    font-weight: 500;
    font-variant: small-caps;
    letter-spacing: 0.08em;
    line-height: 1;
}
header .label { font-style: italic; font-size: 12pt; color: var(--primary); margin-top: 1mm; }
header .contact { margin-top: 1.5mm; }
header .contact > span { white-space: nowrap; }
header .contact > span + span::before { content: "·"; color: var(--primary); margin: 0 0.45em; }
header .summary { margin-top: 2mm; text-align: justify; }
.portrait {
    float: right;
    width: 22mm;
    height: 22mm;
    border-radius: 50%;
    object-fit: cover;
    filter: grayscale(1);
}

/* Section titles, centred between two rules. */
h2 {
    display: flex;
    align-items: center;
    gap: 3mm;
    color: var(--primary);
    font-size: 11.5pt;
    font-weight: 500;
    font-variant: small-caps;
    letter-spacing: 0.14em;
    margin: 3.4mm 0 1.6mm;
    break-after: avoid;
}
h2::before, h2::after { content: ""; flex: 1; border-top: 0.6pt solid var(--primary); }

/* Dates (or labels) hang in a narrow left column. */
.entry {
    display: grid;
    grid-template-columns: 26mm 1fr;
    column-gap: 4mm;
    margin-bottom: 1.3mm;
    break-inside: avoid;
}
.when { text-align: right; color: var(--muted); font-style: italic; }
.url { color: var(--primary); font-size: 9.5pt; letter-spacing: 0.02em; }

.columns { column-count: 2; column-gap: 7mm; }
.columns > * { break-inside: avoid; }
.columns .entry { display: block; }
.columns p, .skills p { text-align: justify; hyphens: auto; }
.skills p { margin-bottom: 1.2mm; }
.references { display: grid; grid-template-columns: 1fr 1fr; column-gap: 8mm; }
</style>
