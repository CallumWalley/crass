<style>
:root {
    --primary: {{ options.color_primary }};
    --text: #2b2f33;
    --muted: #6b7178;
    --rule: #d8dbdf;
}
@page { size: A4; margin: 0; }
* { box-sizing: border-box; margin: 0; padding: 0; }
/* The sidebar colour is painted on the page, so it fills every page of a multi-page pdf. */
html {
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
    background: linear-gradient(to right, var(--primary) 64mm, white 64mm);
}
body {
    font-family: 'Inter', 'Helvetica', 'Arial', sans-serif;
    font-size: 8.3pt;
    line-height: 1.34;
    color: var(--text);
}
a { color: inherit; text-decoration: none; }
.muted { color: var(--muted); }

.page {
    width: 210mm;
    min-height: 297mm;
    display: grid;
    grid-template-columns: 64mm 1fr;
}

/* Sidebar */
.sidebar {
    color: white;
    padding: 10mm 6.5mm 4mm;
}
.portrait {
    display: block;
    width: 34mm;
    height: 34mm;
    margin: 0 auto 1mm;
    border-radius: 50%;
    object-fit: cover;
    border: 1mm solid rgba(255, 255, 255, 0.85);
}
.sidebar h2 {
    font-size: 7.6pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    border-bottom: 1px solid rgba(255, 255, 255, 0.4);
    padding-bottom: 1mm;
    margin: 5.5mm 0 2mm;
}
.sidebar h3 {
    font-size: 8pt;
    font-weight: 600;
    margin: 2mm 0 0.8mm;
}
.contact, .plain { list-style: none; }
.contact li {
    display: flex;
    gap: 2.2mm;
    align-items: baseline;
    margin-bottom: 1mm;
    overflow-wrap: anywhere;
}
.contact i { width: 3.4mm; text-align: center; opacity: 0.8; }
.plain li { margin-bottom: 1mm; }
.education { margin-bottom: 1.5mm; }
.issuer { opacity: 0.7; font-size: 7.2pt; white-space: nowrap; }
.chips { display: flex; flex-wrap: wrap; gap: 0.9mm; }
.chips span {
    background: rgba(255, 255, 255, 0.15);
    border-radius: 0.8mm;
    padding: 0.2mm 1.5mm;
    font-size: 7.2pt;
}

/* Main column */
main { padding: 10mm 9mm 4mm 8mm; }
header h1 {
    font-size: 25pt;
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.015em;
}
header .label {
    color: var(--primary);
    font-size: 9pt;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    margin-top: 1.5mm;
}
header .summary { margin-top: 3mm; }
main h2 {
    display: flex;
    align-items: center;
    gap: 3mm;
    color: var(--primary);
    font-size: 9.5pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    margin: 5mm 0 2.2mm;
}
main h2::after { content: ""; flex: 1; border-bottom: 1px solid var(--rule); }

/* Timeline, the line and stations are a nod to the metro theme. */
.entry {
    display: grid;
    grid-template-columns: 15mm 1fr;
    column-gap: 4mm;
    break-inside: avoid;
}
.entry__when {
    color: var(--muted);
    font-size: 7.4pt;
    text-align: right;
    line-height: 1.25;
    padding-top: 0.3mm;
}
.entry__body {
    position: relative;
    padding: 0 0 2.2mm 4mm;
    border-left: 0.45mm solid color-mix(in srgb, var(--primary) 35%, white);
}
.entry:last-of-type .entry__body { border-left-color: transparent; }
.entry__body::before {
    content: "";
    position: absolute;
    left: -1.5mm;
    top: 0.9mm;
    width: 2.55mm;
    height: 2.55mm;
    border-radius: 50%;
    background: white;
    border: 0.55mm solid var(--primary);
}
.entry h3 { font-size: 8.8pt; font-weight: 600; }
.entry__position { color: var(--primary); font-weight: 500; }
.entry ul { padding-left: 3.4mm; margin-top: 0.4mm; }
.entry li::marker { color: var(--primary); }
.entry__url { color: var(--muted); font-size: 7.4pt; }

.references { display: grid; grid-template-columns: 1fr 1fr; gap: 3mm; }
.reference { border-left: 0.45mm solid var(--primary); padding-left: 3mm; }
.reference h3 { font-size: 8.8pt; font-weight: 600; }
</style>
